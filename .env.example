# text-adventure-rpg Web 层环境变量样例。复制为 .env 并按需修改。
# 铁律：LLM_MODE 必填（mock | live），禁止默认兜底——缺失即启动失败。

# mock：本地确定性模板叙事，零网络零 Key（测试与离线演示用）。
# live：OpenAI 兼容端点直调 LLM 渲染叙事（下面三键全部必填）。
LLM_MODE=mock

# OpenAI 兼容端点根路径。家族先例：MiniMax 中国版 https://api.minimaxi.com/v1
LLM_BASE_URL=

# API Key——只放 .env（已 gitignore），绝不提交仓库。
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型名，如 MiniMax-M2.5 / MiniMax-M3（<think> 内联思维链已被服务端剥离）。
LLM_MODEL=

# Web 服务端口（dev 家族段 8805；前端 vite dev 5805 代理到此）。
APP_PORT=8805

# battle- 存档目录；留空 = ~/.text-adventure-rpg/saves/（与 CLI 共享）。
APP_SAVES_DIR=
